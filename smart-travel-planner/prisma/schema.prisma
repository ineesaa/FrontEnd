generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  country       String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  trips     Trip[]
  favorites Favorite[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Trip {
  id          String   @id @default(uuid())
  userId      String
  destination String
  country     String
  city        String
  startDate   DateTime
  endDate     DateTime
  budget      Decimal  @db.Decimal(10, 2)
  description String?  @db.Text
  coverImage  String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  itineraryDays ItineraryDay[]
  expenses      Expense[]

  @@index([userId])
  @@map("trips")
}

model ItineraryDay {
  id        String   @id @default(uuid())
  tripId    String
  dayNumber Int
  date      DateTime

  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@unique([tripId, dayNumber])
  @@map("itinerary_days")
}

model Activity {
  id             String    @id @default(uuid())
  itineraryDayId String
  title          String
  notes          String?
  order          Int
  startTime      DateTime?

  itineraryDay ItineraryDay @relation(fields: [itineraryDayId], references: [id], onDelete: Cascade)

  @@index([itineraryDayId])
  @@map("activities")
}

enum ExpenseCategory {
  HOTEL
  FOOD
  TRANSPORTATION
  ENTERTAINMENT
  SHOPPING
  OTHER
}

model Expense {
  id       String          @id @default(uuid())
  tripId   String
  category ExpenseCategory
  title    String
  amount   Decimal         @db.Decimal(10, 2)
  date     DateTime        @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("expenses")
}

enum FavoriteType {
  DESTINATION
  ATTRACTION
  RESTAURANT
}

model Favorite {
  id        String       @id @default(uuid())
  userId    String
  type      FavoriteType
  name      String
  location  String?
  latitude  Float?
  longitude Float?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("favorites")
}
